# ─── Required ───────────────────────────────────────────────────────────────
# OpenRouter API key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Web search provider key. Pick ONE (Tavily is the default provider).
#   Tavily:  https://tavily.com   (SEARCH_PROVIDER=tavily)
#   Serper:  https://serper.dev   (SEARCH_PROVIDER=serper)
TAVILY_API_KEY=tvly-...
# SERPER_API_KEY=...

# Absolute site origin, used for the report page's OG meta (metadataBase).
# Falls back to Vercel's VERCEL_URL, then http://localhost:3000 in dev.
# NEXT_PUBLIC_BASE_URL=https://scribble.xyz

# ─── Lead storage ────────────────────────────────────────────────────────────
# If BOTH are set, leads are stored in Upstash Redis (durable on Vercel).
# If unset, the app falls back to a local JSON file store (zero-config dev).
# Create a free Redis DB at https://console.upstash.com/
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# Protects GET /api/leads. Send it as the `x-admin-key` request header.
# ADMIN_KEY=choose-a-long-random-string

# ─── Optional (sane defaults in src/lib/config.ts) ───────────────────────────
# SEARCH_PROVIDER=tavily
# LLM_MODEL=anthropic/claude-sonnet-4.5  # OpenRouter model slug used for all LLM calls
# LEADS_THRESHOLD_USD=50             # anchor monthly price (USD) at/above which visibility is classified as a leads channel
# PERPLEXITY_ENGINE_MODEL=perplexity/sonar        # real-engine check: Perplexity, via OpenRouter
# CHATGPT_ENGINE_MODEL=openai/gpt-4o:online       # real-engine check: web-search-enabled ChatGPT, via OpenRouter
# ENGINE_TIMEOUT_MS=20000            # per-call timeout for each engine's raw answer + judge calls
# LEAD_STORE_PATH=./data/leads.json  # JSON-file store location (local dev)
# AUDIT_REQUEST_STORE_PATH=./data/audit-requests.json  # "email me the audit" leads (local dev)
# INDEX_WORKSPACE_STORE_PATH=./data/index-workspaces.json

# ─── Index outreach (optional until sending) ───────────────────────────────
# Index can discover and qualify leads without these. Both are required for
# an approved email to be sent from Scribble.
# RESEND_API_KEY=re_...
# OUTREACH_FROM_EMAIL=Scribble <introductions@your-verified-domain.com>

# ─── Persistent allocator pipeline (feature-gated) ─────────────────────────
# Existing workspaces are unchanged until this is enabled and the owner selects
# allocator ICP categories. Paid adapters also require their own license/key.
# ALLOCATOR_PIPELINE_ENABLED=true
# ALLOCATOR_DEMO_MODE=true              # fictional local fixture only; never use as live intelligence
# CRON_SECRET=choose-a-long-random-string
# ALLOCATOR_GRAPH_STORE_PATH=./data/allocator-graph.json
# ALLOCATOR_FEED_SIZE=10
# ALLOCATOR_SEC_ADV_FEED_URL=https://your-etl.example/sec-adv.json
# ALLOCATOR_OFFICIAL_SITES_FEED_URL=https://your-etl.example/official-sites.json
# ALLOCATOR_ONCHAIN_FEED_URL=https://your-etl.example/onchain.json
# ALLOCATOR_CRUNCHBASE_FEED_URL=...  # also requires CRUNCHBASE_API_KEY
# ALLOCATOR_PITCHBOOK_FEED_URL=...   # also requires PITCHBOOK_API_KEY
# ALLOCATOR_ROOTDATA_FEED_URL=...    # also requires ROOTDATA_API_KEY
# ALLOCATOR_NANSEN_FEED_URL=...      # also requires NANSEN_API_KEY
# ALLOCATOR_ARKHAM_FEED_URL=...      # also requires ARKHAM_API_KEY
